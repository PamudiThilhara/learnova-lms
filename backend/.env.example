NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/learnova
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional: required to run the development-only sample seed.
SEED_PASSWORD=
ALLOW_SAMPLE_SEED=false
# Initial administrator, used only by npm run create-admin:
ADMIN_NAME=Learnova Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required for password-reset email delivery; no reset tokens are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional AI PDF quiz generator. Keep the key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Future private lesson-video uploads (not enabled by this release).
# YouTube lessons need no storage credentials or YouTube API key.
# These reserved settings alone do not enable MP4/WebM uploads; see VIDEO_LESSONS.md.
VIDEO_S3_REGION=
VIDEO_S3_BUCKET=
# Prefer a scoped IAM role on hosted infrastructure. For local development only:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
